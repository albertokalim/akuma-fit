{
  "sections": [
    {
      "id": "personal",
      "title": "Información Personal",
      "fields": [
        {
          "type": "text",
          "id": "fullName",
          "label": "Nombre Completo",
          "placeholder": "Tu nombre",
          "required": true
        },
        {
          "type": "email",
          "id": "email",
          "label": "Email",
          "placeholder": "tu@email.com",
          "required": true
        },
        {
          "type": "number",
          "id": "age",
          "label": "Edad",
          "placeholder": "25",
          "required": true
        },
        {
          "type": "radio",
          "id": "gender",
          "label": "Sexo",
          "required": true,
          "options": [
            { "value": "hombre", "label": "Hombre" },
            { "value": "mujer", "label": "Mujer" },
            { "value": "otro", "label": "Otro" }
          ]
        }
      ]
    },
    {
      "id": "training",
      "title": "Entrenamiento",
      "fields": [
        {
          "type": "radio",
          "id": "currentObjective",
          "label": "¿Cuál es tu objetivo principal?",
          "required": true,
          "options": [
            { "value": "perderGrasa", "label": "Pérdida de grasa" },
            { "value": "ganarMusculo", "label": "Ganancia de músculo" },
            { "value": "mejorarSalud", "label": "Mejorar salud" },
            { "value": "aumentarFuerza", "label": "Aumentar fuerza" }
          ]
        },
        {
          "type": "radio",
          "id": "experience",
          "label": "Nivel de experiencia",
          "required": true,
          "options": [
            { "value": "principiante", "label": "Principiante (sin experiencia)" },
            { "value": "intermedio", "label": "Intermedio (6-12 meses)" },
            { "value": "avanzado", "label": "Avanzado (más de 1 año)" }
          ]
        },
        {
          "type": "number",
          "id": "hoursPerWeek",
          "label": "Horas disponibles por semana para entrenar",
          "placeholder": "4",
          "required": true
        }
      ]
    },
    {
      "id": "health",
      "title": "Salud",
      "fields": [
        {
          "type": "checkbox",
          "id": "healthConditions",
          "label": "¿Tienes alguna condición de salud que debemos conocer?",
          "required": false,
          "options": [
            { "value": "diabetes", "label": "Diabetes" },
            { "value": "hipertension", "label": "Hipertensión" },
            { "value": "asma", "label": "Asma" },
            { "value": "ninguna", "label": "Ninguna" }
          ]
        },
        {
          "type": "checkbox",
          "id": "injuries",
          "label": "¿Tienes alguna lesión actual o pasada?",
          "required": false,
          "options": [
            { "value": "espalda", "label": "Espalda" },
            { "value": "rodilla", "label": "Rodilla" },
            { "value": "hombro", "label": "Hombro" },
            { "value": "cuello", "label": "Cuello" },
            { "value": "ninguna", "label": "Ninguna" }
          ]
        },
        {
          "type": "scale",
          "id": "stress",
          "label": "Nivel actual de estrés",
          "required": true,
          "min": 1,
          "max": 10,
          "leftLabel": "Bajo",
          "rightLabel": "Alto"
        }
      ]
    },
    {
      "id": "nutrition",
      "title": "Nutrición",
      "fields": [
        {
          "type": "radio",
          "id": "dietFollowing",
          "label": "¿Sigues alguna dieta específica?",
          "required": true,
          "options": [
            { "value": "omnivora", "label": "Omnívora" },
            { "value": "vegetariana", "label": "Vegetariana" },
            { "value": "vegana", "label": "Vegana" },
            { "value": "keto", "label": "Cetogénica" },
            { "value": "otra", "label": "Otra" }
          ]
        },
        {
          "type": "checkbox",
          "id": "supplements",
          "label": "¿Te interesan los suplementos?",
          "required": false,
          "options": [
            { "value": "proteina", "label": "Proteína" },
            { "value": "creatina", "label": "Creatina" },
            { "value": "multivitaminico", "label": "Multivitamínico" },
            { "value": "omega3", "label": "Omega 3" },
            { "value": "ninguno", "label": "Ninguno" }
          ]
        }
      ]
    }
  ]
}
